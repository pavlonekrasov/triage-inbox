[
  {
    "name": "s2-flow",
    "url": "http://localhost:3000/slides/flow",
    "width": 1440,
    "height": 900,
    "scale": 2,
    "theme": "day",
    "waitFor": "document.querySelector('[data-slide][data-ready=true]') && [...document.querySelectorAll('iframe')].every(f => f.dataset.loaded === 'true' && f.contentDocument.querySelector('[data-glass=thread-header]') && !f.contentDocument.querySelector('[data-ssr]'))",
    "waitMs": 700,
    "actions": [
      "document.querySelector('nextjs-portal')?.remove(); document.querySelector('[data-prototype-controls]')?.remove(); document.querySelector('[data-slide-controls]')?.setAttribute('hidden', ''); for (const f of document.querySelectorAll('iframe')) { f.contentDocument.querySelector('nextjs-portal')?.remove(); }",
      "document.fonts.ready"
    ],
    "eval": "(() => { if (document.documentElement.scrollWidth > innerWidth || document.documentElement.scrollHeight > innerHeight) throw new Error('Export exceeds the slide bounds'); return { width: innerWidth, height: innerHeight, theme: document.documentElement.classList.contains('dark') ? 'night' : 'day' }; })()",
    "out": "docs/evidence/slides/s2-flow.png"
  },
